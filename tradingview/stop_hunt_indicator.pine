//@version=5
indicator("ICT Stop Hunt Model", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ── Inputs ────────────────────────────────────────────────────────────────────
asian_start_hour = input.int(20, "Asian KZ Start (NY hour)", minval=0, maxval=23)
asian_end_hour   = input.int(22, "Asian KZ End (NY hour)",   minval=0, maxval=23)
min_asian_pips   = input.float(10.0, "Min Asian Range (pips)")
sl_buffer_pips   = input.float(3.0,  "SL Buffer (pips)")
min_fvg_pips     = input.float(1.0,  "Min FVG Size (pips)")
show_asian_box   = input.bool(true,  "Show Asian KZ Box")
show_bpr         = input.bool(true,  "Show BPR Zones")
show_fvg         = input.bool(true,  "Show FVG Zones")
show_signals     = input.bool(true,  "Show Entry/SL/TP")

// ── Constants ─────────────────────────────────────────────────────────────────
pip = syminfo.mintick * 10
var float asian_high = na
var float asian_low  = na
var bool  in_asian   = false
var bool  asian_done = false
var int   asian_end_bar = na

// ── Session detection ─────────────────────────────────────────────────────────
ny_hour = hour(time, "America/New_York")
ny_min  = minute(time, "America/New_York")

is_asian_kz = (ny_hour >= asian_start_hour and ny_hour < asian_end_hour)
is_ny_morning = (ny_hour >= 7 and ny_hour < 10)

// ── Asian Range Detection ─────────────────────────────────────────────────────
var float session_high = na
var float session_low  = na
var int   session_start_bar = na
var box   asian_box = na

// Detect Asian KZ start
if is_asian_kz and not is_asian_kz[1]
    session_high      := high
    session_low       := low
    session_start_bar := bar_index
    in_asian          := true
    asian_done        := false

// Build Asian range during KZ
if is_asian_kz and in_asian
    session_high := math.max(session_high, high)
    session_low  := math.min(session_low,  low)

// Asian KZ ends
if not is_asian_kz and is_asian_kz[1] and in_asian
    asian_high    := session_high
    asian_low     := session_low
    asian_done    := true
    in_asian      := false
    asian_end_bar := bar_index

    // Draw Asian KZ box
    if show_asian_box
        asian_box := box.new(session_start_bar, session_high, bar_index,
                             session_low, border_color=color.new(color.orange, 0),
                             border_width=1, bgcolor=color.new(color.orange, 88))

// Draw Asian High/Low lines after KZ
var line asian_high_line = na
var line asian_low_line  = na

if asian_done and bar_index == asian_end_bar
    asian_high_line := line.new(bar_index, asian_high, bar_index + 200,
                                asian_high, color=color.orange,
                                style=line.style_dotted, width=1)
    asian_low_line  := line.new(bar_index, asian_low,  bar_index + 200,
                                asian_low,  color=color.orange,
                                style=line.style_dotted, width=1)
    label.new(bar_index, asian_high, "Asian H " + str.tostring(asian_high, "#.#####"),
              color=color.new(color.orange, 80), textcolor=color.orange,
              style=label.style_label_right, size=size.small)
    label.new(bar_index, asian_low, "Asian L " + str.tostring(asian_low, "#.#####"),
              color=color.new(color.orange, 80), textcolor=color.orange,
              style=label.style_label_right, size=size.small)

// ── FVG Detection ─────────────────────────────────────────────────────────────
// Bullish FVG: low[0] > high[2]
// Bearish FVG: high[0] < low[2]

is_bull_fvg = low > high[2] and (low - high[2]) >= min_fvg_pips * pip
is_bear_fvg = high < low[2] and (low[2] - high) >= min_fvg_pips * pip

bull_fvg_top    = is_bull_fvg ? low    : na
bull_fvg_bottom = is_bull_fvg ? high[2] : na
bear_fvg_top    = is_bear_fvg ? low[2]  : na
bear_fvg_bottom = is_bear_fvg ? high   : na

// Only show FVGs above Asian High (for SHORT) or below Asian Low (for LONG)
show_bull_fvg_zone = is_bull_fvg and not na(asian_low) and
                     (bull_fvg_top + bull_fvg_bottom) / 2 <= asian_low and
                     not is_asian_kz

show_bear_fvg_zone = is_bear_fvg and not na(asian_high) and
                     (bear_fvg_top + bear_fvg_bottom) / 2 >= asian_high and
                     not is_asian_kz

if show_fvg and show_bull_fvg_zone
    box.new(bar_index - 2, bull_fvg_top, bar_index + 50, bull_fvg_bottom,
            border_color=color.new(color.green, 0), border_width=1,
            bgcolor=color.new(color.green, 80))
    label.new(bar_index - 1, (bull_fvg_top + bull_fvg_bottom) / 2, "Bull FVG",
              color=color.new(color.green, 70), textcolor=color.green,
              style=label.style_label_right, size=size.tiny)

if show_fvg and show_bear_fvg_zone
    box.new(bar_index - 2, bear_fvg_top, bar_index + 50, bear_fvg_bottom,
            border_color=color.new(color.red, 0), border_width=1,
            bgcolor=color.new(color.red, 80))
    label.new(bar_index - 1, (bear_fvg_top + bear_fvg_bottom) / 2, "Bear FVG",
              color=color.new(color.red, 70), textcolor=color.red,
              style=label.style_label_right, size=size.tiny)

// ── BPR Detection ─────────────────────────────────────────────────────────────
// BPR = overlap of bullish FVG and bearish FVG
// Store last bull/bear FVG zones for overlap check
var float last_bull_top    = na
var float last_bull_bottom = na
var float last_bear_top    = na
var float last_bear_bottom = na

if is_bull_fvg
    last_bull_top    := bull_fvg_top
    last_bull_bottom := bull_fvg_bottom

if is_bear_fvg
    last_bear_top    := bear_fvg_top
    last_bear_bottom := bear_fvg_bottom

// Check overlap
bpr_top    = math.min(nz(last_bull_top, 0),    nz(last_bear_top, 0))
bpr_bottom = math.max(nz(last_bull_bottom, 0), nz(last_bear_bottom, 0))
has_bpr    = bpr_top > bpr_bottom and
             (bpr_top - bpr_bottom) >= min_fvg_pips * pip

// BPR for SHORT — must be above Asian High
show_bpr_short = has_bpr and not na(asian_high) and
                 (bpr_top + bpr_bottom) / 2 >= asian_high and
                 not is_asian_kz and (is_bear_fvg or is_bear_fvg[1] or is_bear_fvg[2])

// BPR for LONG — must be below Asian Low
show_bpr_long = has_bpr and not na(asian_low) and
                (bpr_top + bpr_bottom) / 2 <= asian_low and
                not is_asian_kz and (is_bull_fvg or is_bull_fvg[1] or is_bull_fvg[2])

if show_bpr and show_bpr_short
    box.new(bar_index, bpr_top, bar_index + 80, bpr_bottom,
            border_color=color.new(color.yellow, 0), border_width=2,
            bgcolor=color.new(color.yellow, 70))
    label.new(bar_index, bpr_top, "BPR SHORT",
              color=color.new(color.yellow, 60), textcolor=color.yellow,
              style=label.style_label_right, size=size.small)

if show_bpr and show_bpr_long
    box.new(bar_index, bpr_top, bar_index + 80, bpr_bottom,
            border_color=color.new(color.yellow, 0), border_width=2,
            bgcolor=color.new(color.yellow, 70))
    label.new(bar_index, bpr_bottom, "BPR LONG",
              color=color.new(color.yellow, 60), textcolor=color.yellow,
              style=label.style_label_right, size=size.small)

// ── Sweep Detection ───────────────────────────────────────────────────────────
var bool sweep_high_done = false
var bool sweep_low_done  = false

sweep_high = not na(asian_high) and close > asian_high and
             not sweep_high_done and not is_asian_kz and asian_done
sweep_low  = not na(asian_low)  and close < asian_low  and
             not sweep_low_done  and not is_asian_kz and asian_done

if sweep_high
    sweep_high_done := true
    label.new(bar_index, high, "⚡ SWEEP H",
              color=color.new(color.purple, 0), textcolor=color.white,
              style=label.style_label_down, size=size.small)

if sweep_low
    sweep_low_done := true
    label.new(bar_index, low, "⚡ SWEEP L",
              color=color.new(color.purple, 0), textcolor=color.white,
              style=label.style_label_up, size=size.small)

// Reset on new Asian session
if is_asian_kz and not is_asian_kz[1]
    sweep_high_done := false
    sweep_low_done  := false

// ── NY Morning Session shading ────────────────────────────────────────────────
bgcolor(is_ny_morning ? color.new(color.blue, 93) : na, title="NY Morning Session")
bgcolor(is_asian_kz   ? color.new(color.orange, 93) : na, title="Asian Kill Zone")
